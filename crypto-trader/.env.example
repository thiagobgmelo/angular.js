# --- Acesso (obrigatório em deploy exposto) ---
# Token exigido em todas as rotas /api/* quando definido.
# Gere um forte: openssl rand -hex 32
API_TOKEN=

# Domínio para o HTTPS automático do Caddy (docker compose). Ex.: trader.seudominio.com
DOMAIN=localhost

# --- Alertas via Telegram (opcional — deixe vazio para desativar) ---
# Crie um bot com o @BotFather e pegue o chat id com o @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dados ---
# demo = offline sintético; binance/bybit/... = exchange real via ccxt
# Com execução Bybit ativa, use bybit também no feed (mesma fonte que executa)
# EXCHANGE_ID=bybit

# --- Execução real (Bybit perpétuos USDT) ---
# SEM chaves = executor dry-run (simula e loga, nada sai para a exchange).
# Crie a chave SEM permissão de saque e com whitelist do IP do servidor.
# BYBIT_TESTNET=1 usa o sandbox (testnet.bybit.com) — valide lá primeiro!
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=1
