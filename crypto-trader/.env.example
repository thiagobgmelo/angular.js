# --- Acesso (obrigatório em deploy exposto) ---
# Token exigido em todas as rotas /api/* quando definido.
# Gere um forte: openssl rand -hex 32
API_TOKEN=

# Domínio para o HTTPS automático do Caddy (docker compose). Ex.: trader.seudominio.com
DOMAIN=localhost

# --- Alertas via Telegram (opcional — deixe vazio para desativar) ---
# Crie um bot com o @BotFather e pegue o chat id com o @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dados ---
# demo = offline sintético; binance/bybit/... = exchange real via ccxt
# EXCHANGE_ID=binance
